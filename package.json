{
  "name": "no-telemetry",
  "version": "0.1.0",
  "description": "Detect JS/TS libraries with telemetry and set opt-out env vars in one command.",
  "homepage": "https://github.com/apvarun/no-telemetry#readme",
  "bugs": {
    "url": "https://github.com/apvarun/no-telemetry/issues"
  },
  "license": "MIT",
  "author": "apvarun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apvarun/no-telemetry.git"
  },
  "bin": {
    "no-telemetry": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.20.0"
}
